# ── Stripe Price IDs (set after running scripts/setup-stripe-products.js) ──
STRIPE_PRICE_PAPER_A_MONTHLY=price_xxx
STRIPE_PRICE_PAPER_A_CYCLE=price_xxx
STRIPE_PRICE_PAPER_B_MONTHLY=price_xxx
STRIPE_PRICE_PAPER_B_CYCLE=price_xxx
STRIPE_PRICE_BUNDLE_MONTHLY=price_xxx
STRIPE_PRICE_BUNDLE_CYCLE=price_xxx

# ── Site ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://psychstar.io
